<Window x:Class="OpenHikeMap.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding L[SettingsWindowTitle]}"
        Height="680"
        Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="{Binding L[SettingsTabAppearance]}">
                <ScrollViewer>
                    <GroupBox Header="{Binding L[SettingsAppearanceGroup]}" Margin="10">
                        <Grid Margin="5,10,5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{Binding L[SettingsLanguage]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding Settings.LanguageCode}" Margin="0,5,0,0" />
                            <Label Grid.Row="1" Grid.Column="0" Content="{Binding L[SettingsTheme]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding Settings.ThemeMode}" Margin="0,5,0,0" />
                            <Label Grid.Row="2" Grid.Column="0" Content="{Binding L[SettingsMap]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableMapStyles}" SelectedItem="{Binding Settings.MapStyle}" Margin="0,5,0,0" />
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="{Binding L[SettingsTrails]}" IsChecked="{Binding Settings.ShowHikingTrails}" Margin="0,5,0,0" />
                            <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="{Binding L[SettingsContours]}" IsChecked="{Binding Settings.ShowContourLines}" Margin="0,5,0,0" />
                            <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Content="{Binding L[SettingsSatellite]}" IsChecked="{Binding Settings.ShowSatelliteOverlay}" Margin="0,5,0,0" />
                            <CheckBox Grid.Row="6" Grid.ColumnSpan="2" Content="{Binding L[SettingsWeather]}" IsChecked="{Binding Settings.ShowWeather}" Margin="0,5,0,0" />
                            <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="{Binding L[SettingsWeatherGradients]}" IsChecked="{Binding Settings.ShowWeatherGradients}" Margin="0,5,0,0" />
                            <CheckBox Grid.Row="8" Grid.ColumnSpan="2" Content="{Binding L[SettingsCivilAlerts]}" IsChecked="{Binding Settings.ShowCivilProtectionAlerts}" Margin="0,5,0,0" />
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding L[SettingsTabUnits]}">
                <ScrollViewer>
                    <GroupBox Header="{Binding L[SettingsUnitsGroup]}" Margin="10">
                        <Grid Margin="5,10,5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{Binding L[SettingsUnitPreset]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableUnitPresets}" SelectedItem="{Binding Settings.UnitPreset}" Margin="0,5,0,0" SelectionChanged="UnitPreset_SelectionChanged" />
                            <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Content="{Binding L[SettingsMetric]}" IsChecked="{Binding Settings.IsMetric}" Margin="0,5,0,0" />
                            <Label Grid.Row="2" Grid.Column="0" Content="{Binding L[SettingsDistance]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding AvailableDistanceUnits}" SelectedItem="{Binding Settings.DistanceUnit}" Margin="0,5,0,0" />
                            <Label Grid.Row="3" Grid.Column="0" Content="{Binding L[SettingsAltitude]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableAltitudeUnits}" SelectedItem="{Binding Settings.AltitudeUnit}" Margin="0,5,0,0" />
                            <Label Grid.Row="4" Grid.Column="0" Content="{Binding L[SettingsSpeed]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding AvailableSpeedUnits}" SelectedItem="{Binding Settings.SpeedUnit}" Margin="0,5,0,0" />
                            <Label Grid.Row="5" Grid.Column="0" Content="{Binding L[SettingsTravelSpeed]}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.TravelSpeed}" Margin="0,5,0,0" />
                            <Label Grid.Row="6" Grid.Column="0" Content="{Binding L[SettingsPressure]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding AvailablePressureUnits}" SelectedItem="{Binding Settings.PressureUnit}" Margin="0,5,0,0" />
                            <Label Grid.Row="7" Grid.Column="0" Content="{Binding L[SettingsTemperature]}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding AvailableTemperatureUnits}" SelectedItem="{Binding Settings.TemperatureUnit}" Margin="0,5,0,0" />
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{Binding L[SettingsTabView]}">
                <ScrollViewer>
                    <StackPanel>
                        <GroupBox Header="{Binding L[SettingsViewGroup]}" Margin="10">
                            <Grid Margin="5,10,5,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Content="{Binding L[SettingsInitialZoom]}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.DefaultZoom}" Margin="0,5,0,0" />
                                <Label Grid.Row="1" Grid.Column="0" Content="{Binding L[SettingsInitialLatitude]}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.DefaultLatitude}" Margin="0,5,0,0" />
                                <Label Grid.Row="2" Grid.Column="0" Content="{Binding L[SettingsInitialLongitude]}" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.DefaultLongitude}" Margin="0,5,0,0" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Imposta home" Margin="10">
                            <StackPanel Margin="5">
                                <Label Content="{Binding L[SettingsSearchCenterLabel]}" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DefaultCenterSearchTextBox" Grid.Column="0" Margin="0,0,8,0" />
                                    <Button Grid.Column="1" Content="Cerca" Click="SearchDefaultCenter_Click" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="Imposta home" Click="SetDefaultCenterHome_Click" />
                                </Grid>
                                <TextBlock x:Name="DefaultCenterPreviewTextBlock" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding L[CancelButton]}" Width="96" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="{Binding L[SaveButton]}" Width="96" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="OpenHikeMap.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{Binding WindowTitle}"
        Height="280"
        Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="OpenHikeMap" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="{Binding DescriptionLine1}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding DescriptionLine2}" TextWrapping="Wrap" Margin="0,10,0,0" />
            <Separator Margin="0,10,0,0" />
            <TextBlock Margin="0,10,0,0" Text="{Binding CreditsLine}" TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                <Hyperlink NavigateUri="{Binding GitHubUrl}" RequestNavigate="Hyperlink_RequestNavigate">
                    <Run Text="{Binding GitHubUrl}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
        <Button Grid.Row="1" Content="{Binding CloseButtonText}" Width="100" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_Click" />
    </Grid>
</Window>

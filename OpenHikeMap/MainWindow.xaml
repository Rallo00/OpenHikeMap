<Window x:Class="OpenHikeMap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenHikeMap"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="{Binding L[WindowTitle]}"
        Height="960"
        Width="1560"
        MinHeight="760"
        MinWidth="1280"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource RoundedTextBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Height" Value="27" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="Height" Value="25" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource RoundedButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="25" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{Binding L[MenuFile]}">
                <MenuItem Header="{Binding L[MenuOpenSession]}" Click="OpenSession_Click" />
                <MenuItem Header="{Binding L[MenuSaveSession]}" Click="SaveSession_Click" />
                <Separator />
                <MenuItem Header="{Binding L[MenuExit]}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{Binding L[MenuPins]}">
                <MenuItem Header="{Binding L[MenuNewPinCoordinates]}" Click="AddPlaceFromCoordinates_Click" />
                <Separator />
                <MenuItem Header="{Binding L[MenuExportKml]}" Click="ExportKml_Click" />
                <MenuItem Header="{Binding L[MenuImportKml]}" Click="ImportKml_Click" />
            </MenuItem>
            <MenuItem Header="{Binding L[MenuRoute]}">
                <MenuItem Header="{Binding L[MenuCalculateRoute]}" Click="CalculateRoute_Click" />
                <MenuItem Header="{Binding L[MenuClearRoute]}" Click="ClearRoute_Click" />
                <Separator />
                <MenuItem Header="{Binding L[MenuImportGpx]}" Click="ImportGpx_Click" />
                <MenuItem Header="{Binding L[MenuExportGpx]}" Click="ExportGpx_Click" />
            </MenuItem>
            <MenuItem Header="{Binding L[MenuSettings]}">
                <MenuItem Header="{Binding L[MenuOpenSettings]}" Click="OpenSettings_Click" />
                <Separator />
                <MenuItem Header="{Binding L[MenuExportSettings]}" Click="ExportSettings_Click" />
                <MenuItem Header="{Binding L[MenuImportSettings]}" Click="ImportSettings_Click" />
                <Separator />
                <MenuItem Header="{Binding L[MenuBackup]}" Click="CreateBackup_Click" />
                <MenuItem Header="{Binding L[MenuRestore]}" Click="RestoreBackup_Click" />
            </MenuItem>
            <MenuItem Header="{Binding L[MenuHelp]}">
                <MenuItem Header="{Binding L[MenuAbout]}" Click="OpenAbout_Click" />
            </MenuItem>
        </Menu>
        <ToolBarTray DockPanel.Dock="Top" Background="{DynamicResource HeaderBackgroundBrush}">
            <ToolBar Background="{DynamicResource HeaderBackgroundBrush}" Height="32">
                <Button Click="GoHome_Click" Margin="0,0,8,0" Width="32" Height="32" ToolTip="{Binding L[ToolbarGoHome]}">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M5 21a2 2 0 0 1-2-2v-9a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2h-3a1 1 0 0 1-1-1v-7a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v7a1 1 0 0 1-1 1z" Fill="{DynamicResource PrimaryTextBrush}" />
                        </Canvas>
                    </Viewbox>
                </Button>
                <Separator />
                <ComboBox Width="180" Height="32" ItemsSource="{Binding AvailableMapStyles}" SelectedItem="{Binding Settings.MapStyle}" Margin="0,0,8,0" />
                <Grid x:Name="ToolbarSearchHost" Width="320" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchTextBox_KeyDown"
                             Margin="0"
                             Height="30"
                             VerticalAlignment="Center"
                             ToolTip="{Binding L[ToolbarSearchPlaceholder]}"
                             Grid.Column="0" />
                    <TextBlock Text="{Binding L[ToolbarSearchPlaceholder]}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontStyle="Italic"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               IsHitTestVisible="False"
                               Grid.Column="0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Click="SearchPlace_Click"
                            Grid.Column="1"
                            Margin="0"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip="{Binding L[ToolbarSearch]}">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M21 21L16.66 16.66 M11 19A8 8 0 1 1 11 3A8 8 0 0 1 11 19Z"
                                      Stroke="{DynamicResource PrimaryTextBrush}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent" />
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Popup PlacementTarget="{Binding ElementName=ToolbarSearchHost}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           IsOpen="{Binding ElementName=ToolbarSearchResultsListBox, Path=HasItems, Mode=OneWay}">
                        <Border Width="320"
                                Margin="0,2,0,0"
                                Padding="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ListBox x:Name="ToolbarSearchResultsListBox"
                                     ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedSearchResult}"
                                     MouseDoubleClick="SearchResults_DoubleClick"
                                     MaxHeight="280"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="SearchResultItem_PreviewMouseRightButtonDown" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Centra nella mappa" Click="CenterOnSearchResult_Click" />
                                        <MenuItem Header="Imposta come punto di destinazione" Click="AddSearchResultAsEnd_Click" />
                                        <MenuItem Header="Imposta come punto di partenza" Click="AddSearchResultAsStart_Click" />
                                        <MenuItem Header="Imposta come waypoint" Click="AddSearchResultAsWaypoint_Click" />
                                        <MenuItem Header="Imposta come home all'avvio" Click="SetSearchResultAsDefaultCenter_Click" />
                                        <MenuItem Header="Crea pin" Click="AddPlaceFromSearchResult_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="8,6"
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>
                <Separator />
                <CheckBox IsChecked="{Binding Settings.ShowHikingTrails}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarShowTrails]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="6" Height="6" Canvas.Left="3" Canvas.Top="16" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" Fill="Transparent" />
                            <Ellipse Width="6" Height="6" Canvas.Left="15" Canvas.Top="2" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" Fill="Transparent" />
                            <Path Data="M9 19H17.5A3.5 3.5 0 0 0 17.5 12H6.5A3.5 3.5 0 0 1 6.5 5H15" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ShowSatelliteOverlay}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarSatellite]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z M15 5.764v15 M9 3.236v15" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ShowContourLines}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarContours]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M8 3L12 11L17 6L22 21H2L8 3Z" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ShowWeather}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarWeather]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 2V4" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            <Path Data="M4.93 4.93L6.34 6.34" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            <Path Data="M20 12H22" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            <Path Data="M19.07 4.93L17.66 6.34" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            <Path Data="M15.947 12.65A4 4 0 0 0 10.022 8.522" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            <Path Data="M13 22H7A5 5 0 1 1 11.9 16H13A3 3 0 0 1 13 22Z" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ShowCivilProtectionAlerts}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarCivilAlerts]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M22 17A2 2 0 0 1 20 19H6.828A2 2 0 0 0 5.414 19.586L3.212 21.788A.71.71 0 0 1 2 21.286V5A2 2 0 0 1 4 3H20A2 2 0 0 1 22 5Z" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                            <Ellipse Width="1.6" Height="1.6" Canvas.Left="11.2" Canvas.Top="14.2" Fill="{DynamicResource PrimaryTextBrush}" />
                            <Path Data="M12 7V11" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ShowSavedPoints}" ToolTip="{Binding L[ToolbarShowSaved]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 17V22" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                            <Path Data="M9 10.76A2 2 0 0 1 7.89 12.55L6.11 13.45A2 2 0 0 0 5 15.24V16A1 1 0 0 0 6 17H18A1 1 0 0 0 19 16V15.24A2 2 0 0 0 17.89 13.45L16.11 12.55A2 2 0 0 1 15 10.76V7A1 1 0 0 1 16 6A2 2 0 0 0 16 2H8A2 2 0 0 0 8 6A1 1 0 0 1 9 7Z" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <Separator />
                <CheckBox IsChecked="{Binding Settings.ShowBearingCircle}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarBearingCircle]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 M22 12 H18 M6 12 H2 M12 6 V2 M12 22 V18" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ShowRulerTool}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarRuler]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M10 15 V12 M14 15 V12 M18 15 V12 M2 8 V4 M22 6 H2 M22 8 V4 M6 15 V12 M4 12 H20 A2 2 0 0 1 22 14 V18 A2 2 0 0 1 20 20 H4 A2 2 0 0 1 2 18 V14 A2 2 0 0 1 4 12"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ShowMapScale}" Margin="0,0,8,0" ToolTip="{Binding L[ToolbarMapScale]}" Width="32" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Data="M21.3 15.3 A2.4 2.4 0 0 1 21.3 18.7 L18.7 21.3 A2.4 2.4 0 0 1 15.3 21.3 L2.7 8.7 A2.41 2.41 0 0 1 2.7 5.3 L5.3 2.7 A2.41 2.41 0 0 1 8.7 2.7 Z M14.5 12.5 L16.5 10.5 M11.5 9.5 L13.5 7.5 M8.5 6.5 L10.5 4.5 M17.5 15.5 L19.5 13.5"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent" />
                        </Canvas>
                    </Viewbox>
                </CheckBox>
            </ToolBar>
        </ToolBarTray>
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="360" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <Expander Grid.Row="0" Grid.Column="0" Header="{Binding L[LeftPaneHeader]}" IsExpanded="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Expander Header="{Binding L[SavedPlacesGroup]}" IsExpanded="True">
                            <StackPanel Margin="5">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Click="CreateFolder_Click" ToolTip="{Binding L[NewFolderButton]}">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M3,7 H10 L12,9 H21 V19 H3 Z" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeLineJoin="Round" Fill="Transparent" />
                                                <Path Data="M12,11 V17 M9,14 H15" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button Click="CreateBlankPlace_Click" ToolTip="{Binding L[NewButton]}">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M12,5 V19 M5,12 H19" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button Click="DeletePlace_Click" ToolTip="{Binding L[DeleteButton]}">
                                        <Viewbox Width="16" Height="16">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4,7 H20 M9,7 V5 H15 V7 M7,7 L8,19 H16 L17,7 M10,11 V16 M14,11 V16" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </WrapPanel>
                                <Grid>
                                    <TextBox Text="{Binding SavedPlacesSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding L[SavedPlacesSearchLabel]}"
                                               Margin="10,0,0,8"
                                               VerticalAlignment="Center"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SavedPlacesSearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TreeView x:Name="SavedPlacesTreeView"
                                          ItemsSource="{Binding PlaceTree}"
                                          SelectedItemChanged="SavedPlacesTreeView_SelectedItemChanged"
                                          MouseDoubleClick="SavedPlacesTreeView_MouseDoubleClick">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type local:PlaceTreeNode}" ItemsSource="{Binding Children}">
                                            <DockPanel LastChildFill="True">
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Folder.IsEnabled}" Visibility="{Binding IsFolder, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Place.IsVisible}" Visibility="{Binding IsPlace, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <GridSplitter Grid.Row="0" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ShowsPreview="True" />
            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource MapHostBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                <wv2:WebView2 x:Name="MapWebView" />
            </Border>
            <GridSplitter Grid.Row="0" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ShowsPreview="True" />
            <Expander Grid.Row="0" Grid.Column="4" Header="{Binding L[RightPaneHeader]}" IsExpanded="True" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Expander Header="{Binding L[SelectedPinGroup]}" IsExpanded="True">
                            <StackPanel Margin="5">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFolder}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Content="{Binding L[NameLabel]}" />
                                    <TextBox x:Name="SelectedFolderNameTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding SelectedFolder.Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <Label Grid.Row="1" Grid.Column="0" Content="{Binding L[DescriptionLabel]}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" IsEnabled="False" Height="152" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                    <Label Grid.Row="2" Grid.Column="0" Content="{Binding L[IconLabel]}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" IsEnabled="False" />
                                    <Label Grid.Row="3" Grid.Column="0" Content="{Binding L[ColorLabel]}" />

            </Expander>
            <Expander Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Header="{Binding L[BottomPaneHeader]}" IsExpanded="{Binding IsProfilePaneExpanded, Mode=TwoWay}" Margin="0,12,0,0" ExpandDirection="Up">
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid x:Name="ProfilePanelGrid" SizeChanged="ProfilePanelGrid_SizeChanged">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProfileDistanceValueText}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProfileDistanceUnitText}" Margin="2,5,0,0" FontSize="13" />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding L[ProfileDistanceLabel]}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                <TextBlock Text="{Binding ProfileDurationText}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding L[ProfileTimeLabel]}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ProfileElevationTotalText}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProfileElevationDetailsText}"
                                               Margin="8,6,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding L[ProfileElevationLabel]}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="{Binding ProfileSlopeDetailsText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding L[ProfileSlopeLabel]}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Height="180">
                            <Canvas Width="{Binding ProfileChartCanvasWidth}" HorizontalAlignment="Left">
                                <Line X1="60" Y1="10" X2="60" Y2="160" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2" />
                                <Line X1="60" Y1="160" X2="{Binding ProfileChartCanvasWidth}" Y2="160" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1.2" />
                                <Path Data="{Binding ProfileFillGeometry}" Fill="#335DAE62" StrokeThickness="0" />
                                <ItemsControl ItemsSource="{Binding ProfileColoredSegments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding Geometry}"
                                                  Stroke="{Binding StrokeHex}"
                                                  StrokeThickness="2.5"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                            <Grid Margin="60,10,0,20"
                                  Width="{Binding ProfileAxisWidth}"
                                  Height="150"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Rectangle Grid.Row="0" Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Fill="#D6D6D6" Opacity="0.85" />
                                <Rectangle Grid.Row="1" Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Fill="#D6D6D6" Opacity="0.85" />
                                <Rectangle Grid.Row="2" Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Fill="#D6D6D6" Opacity="0.85" />
                                <Border Grid.RowSpan="4" Grid.Column="1" BorderBrush="#DADADA" BorderThickness="1,0,0,0" Opacity="0.75" />
                                <Border Grid.RowSpan="4" Grid.Column="2" BorderBrush="#DADADA" BorderThickness="1,0,0,0" Opacity="0.75" />
                                <Border Grid.RowSpan="4" Grid.Column="3" BorderBrush="#DADADA" BorderThickness="1,0,0,0" Opacity="0.75" />
                                <Border Grid.RowSpan="4" Grid.Column="4" BorderBrush="#DADADA" BorderThickness="1,0,0,0" Opacity="0.75" />
                            </Grid>
                            <Border Background="Transparent"
                                    Margin="60,10,0,20"
                                    Width="{Binding ProfileAxisWidth}"
                                    ToolTip="{Binding ProfileHoverText}"
                                    MouseMove="ProfileChartOverlay_MouseMove"
                                    MouseLeave="ProfileChartOverlay_MouseLeave"
                                    HorizontalAlignment="Left" />
                            <Grid Width="58" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Canvas Width="58" Height="170">
                                    <TextBlock Canvas.Left="0" Canvas.Top="0" Text="{Binding ProfileMaxLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock Canvas.Left="0" Canvas.Top="50" Text="{Binding ProfileUpperMidLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock Canvas.Left="0" Canvas.Top="100" Text="{Binding ProfileLowerMidLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock Canvas.Left="0" Canvas.Top="150" Text="{Binding ProfileMinLabel}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                                </Canvas>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2" Margin="60,2,0,0" Width="{Binding ProfileAxisWidth}" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProfileStartDistanceLabel}" HorizontalAlignment="Left" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="{Binding ProfileQuarterDistanceLabel}" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="2" Text="{Binding ProfileMidDistanceLabel}" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="3" Text="{Binding ProfileThreeQuarterDistanceLabel}" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                            <TextBlock Grid.Column="4" Text="{Binding ProfileEndDistanceLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                        </Grid>
                    </Grid>
                </Border>
            </Expander>
        </Grid>
    </DockPanel>
</Window>

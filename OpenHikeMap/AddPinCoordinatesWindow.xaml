<Window x:Class="OpenHikeMap.AddPinCoordinatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aggiungi pin da coordinate"
        Height="190"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,12" Text="Inserisci latitudine e longitudine del nuovo pin." />
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" VerticalAlignment="Center" Text="Latitudine" />
        <TextBox x:Name="LatitudeTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,16,10" Padding="8,6" />
        <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,0,8,10" VerticalAlignment="Center" Text="Longitudine" />
        <TextBox x:Name="LongitudeTextBox" Grid.Row="1" Grid.Column="3" Margin="0,0,0,10" Padding="8,6" />
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annulla" Width="100" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Conferma" Width="100" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>

<Router AppAssembly="typeof(WebApplicationHost).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound><p>Pagina non trovata. <a href="/">Torna alla mappa</a></p></NotFound>
</Router>
